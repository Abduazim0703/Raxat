# Скопируйте этот файл в .env и заполните своими значениями
PORT=3000

# Придумайте длинный случайный ключ — он защищает эндпоинты /api/owner/*
OWNER_API_KEY=change-me-owner-key

# Отдельный ключ для официантов/кухни — защищает /api/staff/*
# (владелец может использовать OWNER_API_KEY — он тоже подходит)
STAFF_API_KEY=change-me-staff-key

# Необязательно: путь к файлу базы данных (по умолчанию ./rahat.db)
# DB_PATH=./rahat.db

# ---------- приём оплаты СБП через ЮKassa ----------
# Пока эти две строчки не заполнены — оплата СБП работает в демо-режиме (без
# реальных денег). Заполнили — заказы начинают оплачиваться по-настоящему.
# Взять в личном кабинете ЮKassa: yookassa.ru → Настройки → Магазин.
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
